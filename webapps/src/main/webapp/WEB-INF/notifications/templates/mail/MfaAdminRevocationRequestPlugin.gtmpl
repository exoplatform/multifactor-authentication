<table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#ffffff" align="center" style="width:100%;overflow-wrap:anywhere;word-break:break-word;background-color: #ffffff; font-size: 15px;color: #1d2327;line-height: 1.7;font-family: ${io.meeds.portal.mail.util.EmailLayout.fontStack()};" dir="${io.meeds.portal.mail.util.EmailLayout.dir(_ctx.language)}">
    <%
      _templateContext.put("header_title", _ctx.appRes("Notification.title.MfaAdminRevocationRequestPlugin"));
      _ctx.include("war:/notification/templates/mail/NotificationHeader.gtmpl", _templateContext);
    %>
    <tr>
        <td style="padding:0 24px;">
            <table role="presentation" cellpadding="0" cellspacing="0" width="100%" bgcolor="#ffffff" style="max-width:600px;margin:0 auto;background-color: #ffffff;">
                <tr>
                    <td bgcolor="#ffffff" style="background-color: #ffffff;">
                        <table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#ffffff" style="background-color: #ffffff; color: #1d2327;line-height: 1.7;">
                            <tr>
                                <td align="${io.meeds.portal.mail.util.EmailLayout.start(_ctx.language)}" bgcolor="#ffffff" style="background-color: #ffffff;padding: 30px 0 10px 0;" dir="auto">
                                    <p style="margin: 0 0 14px; font-size: 15px; color: #1d2327; font-family: ${io.meeds.portal.mail.util.EmailLayout.fontStack()};" dir="auto"><%=_ctx.appRes("Notification.label.SayHello")%> <%=_ctx.escapeHTML(FIRSTNAME)%>,</p>
                                    <table border="0" cellpadding="0" cellspacing="0" width="100%" style="margin: 0 0 10px;">
                                        <tr>
                                            <!--[if mso]>
                                            <td width="64" valign="top">
                                                <img width="44" height="44" style="margin-top: 2px; border-radius: 50%;" src="$AVATAR" alt="<%=_ctx.escapeHTML(USER)%>" />
                                            </td>
                                            <![endif]-->
                                            <td width="64" valign="top" style="mso-hide:all; vertical-align: top; ">
                                                <img width="44" height="44" style="margin-top: 2px; border-radius: 50%; display: block;" src="$AVATAR" alt="<%=_ctx.escapeHTML(USER)%>" />
                                            </td>
                                            <td valign="top" style="vertical-align: top;" dir="auto">
                                                <%
                                                  String profileUrl = "<a target=\"_blank\" style=\"color: ${io.meeds.portal.mail.util.EmailLayout.linkColor()}; text-decoration: none; font-weight: bold; font-family: ${io.meeds.portal.mail.util.EmailLayout.fontStack()};\" href=\""+ PROFILE_URL + "\">" + _ctx.escapeHTML(USER) + "</a>";
                                                %>
                                                <p style="margin:0; color:#1d2327; line-height:1.7; font-size:15px; font-family: ${io.meeds.portal.mail.util.EmailLayout.fontStack()};" dir="auto"><%=_ctx.appRes("Notification.intranet.message.MfaAdminRevocationRequestPlugin", profileUrl)%></p>
                                            </td>
                                        </tr>
                                    </table>
                                    <div dir="${io.meeds.portal.mail.util.EmailLayout.dir(_ctx.language)}" style="margin: 20px 0 8px 0;">
                                        <%=io.meeds.portal.mail.util.EmailLayout.actionLink(_ctx.appRes("Notification.mail.MfaAdminRevocationRequestPlugin.administration"), "$MFA_ADMIN_PAGE_URL", true)%>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </td>
    </tr><!--end content area-->
    <% _ctx.include("war:/notification/templates/mail/NotificationFooter.gtmpl", _templateContext);%>
</table>
